{
  "version": 2,
  "buildCommand": "node build.mjs",
  "outputDirectory": "public",
  "cleanUrls": true,
  "trailingSlash": false,
  "headers": [
    {
      "source": "/framerusercontent.com/(.*)\\.mjs",
      "headers": [
        { "key": "Content-Type", "value": "text/javascript; charset=utf-8" }
      ]
    },
    {
      "source": "/app.framerstatic.com/(.*)\\.mjs",
      "headers": [
        { "key": "Content-Type", "value": "text/javascript; charset=utf-8" }
      ]
    }
  ],
  "rewrites": [
    { "source": "/home-gallery", "destination": "/index.html" },
    { "source": "/home-loop", "destination": "/index.html" },
    { "source": "/home-spiral", "destination": "/index.html" },
    { "source": "/projects/:slug", "destination": "/index.html" }
  ]
}
